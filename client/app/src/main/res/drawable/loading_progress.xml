<?xml version="1.0" encoding="utf-8"?>
<!-- The platform's default horizontal bar is a hairline that disappears at
     arm's length on a handheld, so the track and the fill are drawn here. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <corners android:radius="6dp" />
            <solid android:color="#1B2330" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape android:shape="rectangle">
                <corners android:radius="6dp" />
                <solid android:color="#4C9AFF" />
            </shape>
        </clip>
    </item>
</layer-list>
