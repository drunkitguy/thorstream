<?xml version="1.0" encoding="utf-8"?>
<!-- Focus has to be obvious from across a room, so the focused tile gets a
     bright border rather than a subtle tint. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#1B2330" />
            <stroke android:width="3dp" android:color="#4C9AFF" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#1B2330" />
            <stroke android:width="1dp" android:color="#2A3442" />
            <corners android:radius="8dp" />
        </shape>
    </item>
</selector>
