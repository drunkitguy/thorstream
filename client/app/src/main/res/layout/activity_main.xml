<?xml version="1.0" encoding="utf-8"?>
<!-- First screen: choose a PC. Discovered hosts appear by themselves; the manual
     fields are for a PC that cannot be found by broadcast, such as one reached
     over the internet. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0E1116"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textColor="#FFFFFF"
        android:textSize="26sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/statusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:text="@string/searching"
        android:textColor="#8A93A0"
        android:textSize="13sp" />

    <ListView
        android:id="@+id/hostList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <Button
        android:id="@+id/rescanButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/rescan" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/manual_header"
        android:textColor="#C7CED8"
        android:textSize="13sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/hostInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:autofillHints="192.168.1.10"
        android:hint="@string/hint_host"
        android:inputType="text"
        android:textColor="#FFFFFF"
        android:textColorHint="#5A6474" />

    <EditText
        android:id="@+id/externalInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:autofillHints="home.example.com"
        android:hint="@string/hint_external"
        android:inputType="text"
        android:textColor="#FFFFFF"
        android:textColorHint="#5A6474" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/bitrateInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:autofillHints="30000"
            android:hint="@string/hint_bitrate"
            android:inputType="number"
            android:textColor="#FFFFFF"
            android:textColorHint="#5A6474" />

        <EditText
            android:id="@+id/fpsInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:autofillHints="60"
            android:hint="@string/hint_fps"
            android:inputType="number"
            android:textColor="#FFFFFF"
            android:textColorHint="#5A6474" />
    </LinearLayout>

    <!-- On by default, but switchable: a palm resting on the panel mid-game
         drags the pointer, which is worse than having no touch at all. -->
    <CheckBox
        android:id="@+id/touchCheck"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:checked="true"
        android:text="@string/touch_control"
        android:textColor="#C7CED8"
        android:textSize="13sp" />

    <!-- Which codec to ask the PC for. Auto is right for almost everyone; the
         override exists because a device can advertise a decoder it does not
         really drive well, and that is only ever discovered by trying. -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/codec_header"
        android:textColor="#C7CED8"
        android:textSize="13sp"
        android:textStyle="bold" />

    <RadioGroup
        android:id="@+id/codecGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <RadioButton
            android:id="@+id/codecAuto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:text="@string/codec_auto"
            android:textColor="#C7CED8"
            android:textSize="13sp" />

        <RadioButton
            android:id="@+id/codecAv1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:text="@string/codec_av1"
            android:textColor="#C7CED8"
            android:textSize="13sp" />

        <RadioButton
            android:id="@+id/codecHevc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:text="@string/codec_hevc"
            android:textColor="#C7CED8"
            android:textSize="13sp" />

        <RadioButton
            android:id="@+id/codecH264"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/codec_h264"
            android:textColor="#C7CED8"
            android:textSize="13sp" />
    </RadioGroup>

    <TextView
        android:id="@+id/codecNote"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#8A93A0"
        android:textSize="12sp" />

    <Button
        android:id="@+id/connectButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/connect" />

</LinearLayout>
