<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:keepScreenOn="true">

    <SurfaceView
        android:id="@+id/surface"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center" />

    <!-- Invisible, but focusable: it exists purely to give the soft keyboard
         somewhere to deliver text, which is then forwarded to the host. -->
    <EditText
        android:id="@+id/keyboardSink"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:alpha="0"
        android:inputType="text"
        android:imeOptions="actionNone|flagNoExtractUi"
        android:importantForAutofill="no"
        android:autofillHints="" />

    <TextView
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_margin="10dp"
        android:background="#80000000"
        android:padding="6dp"
        android:textColor="#FFFFFF"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="10dp"
        android:background="#80000000"
        android:padding="6dp"
        android:textColor="#FFFFFF"
        android:textSize="11sp" />

    <!-- Last child, so it covers the corner labels and - being opaque - is
         subtracted from the SurfaceView's transparent region, hiding the black
         hole punched for the video until a frame has actually been decoded. -->
    <LinearLayout
        android:id="@+id/loadingOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#0B0E13"
        android:focusable="false"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="48dp"
        android:paddingEnd="48dp">

        <TextView
            android:id="@+id/loadingTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="2"
            android:textColor="#FFFFFF"
            android:textSize="44sp"
            android:textStyle="bold" />

        <ProgressBar
            android:id="@+id/loadingBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="22dp"
            android:layout_marginTop="36dp"
            android:indeterminate="false"
            android:max="1000"
            android:maxHeight="22dp"
            android:minHeight="22dp"
            android:progressDrawable="@drawable/loading_progress" />

        <TextView
            android:id="@+id/loadingStage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:gravity="center"
            android:textColor="#DCE3ED"
            android:textSize="28sp" />

        <TextView
            android:id="@+id/loadingDetail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:textColor="#8A93A0"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/loadingError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:gravity="center"
            android:textColor="#FF8A80"
            android:textSize="22sp"
            android:visibility="gone" />

        <!-- Always shown: leaving is available for the whole wait, not only
             after something has visibly gone wrong. -->
        <TextView
            android:id="@+id/loadingHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="36dp"
            android:gravity="center"
            android:text="@string/loading_cancel_hint"
            android:textColor="#6C7583"
            android:textSize="17sp" />

    </LinearLayout>

</FrameLayout>
